<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Stage 3: userland downloads extra tools at runtime via busybox wget.
         Native sockets need the app-level INTERNET permission on Android. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phase 1 survival: foreground service keeps shells alive in background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Phase 1.2: let the user exempt Interlux from Doze (network dies else). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Phase 1.3: targetSdk 28 legacy storage -> broad /sdcard as ~/storage. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Phase 3.11: haptics for scan events (install-time grant). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Phase 3.12: restart the terminal service after reboot (opt-out via
         the notification Stop action until next launch). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Phase 3.11: location fix for the device API (runtime prompt). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Kara move-in (M6): inter-app agent control. Signature-level: only
         apps signed with OUR key (Kara, built by us) can drive the daemon. -->
    <permission
        android:name="com.keneristudios.interlux.permission.CONTROL_AGENT"
        android:protectionLevel="signature" />
    <application
        android:label="Interlux"
        android:name=".InterluxApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Interactive terminal shells the user left running in the background." />
        </service>
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Kara move-in (M6): exported agent control (START/STOP/RESTART/
             STATUS), guarded by the signature-level CONTROL_AGENT permission.
             Kara drives it with explicit intents + a result PendingIntent. -->
        <service
            android:name=".agent.AgentControl"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="com.keneristudios.interlux.permission.CONTROL_AGENT">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Short-lived control operations (agent/bot status and restarts) requested by our own apps." />
            <intent-filter>
                <action android:name="com.keneristudios.interlux.action.START_AGENT" />
                <action android:name="com.keneristudios.interlux.action.STOP_AGENT" />
                <action android:name="com.keneristudios.interlux.action.RESTART_AGENT" />
                <action android:name="com.keneristudios.interlux.action.AGENT_STATUS" />
                <action android:name="com.keneristudios.interlux.action.START_BOTS" />
                <action android:name="com.keneristudios.interlux.action.STOP_BOTS" />
                <action android:name="com.keneristudios.interlux.action.BOTS_STATUS" />
                <action android:name="com.keneristudios.interlux.action.BOTS_AUTOSTART" />
            </intent-filter>
        </service>
        <!-- Bot watchdog ticks (Kara move): in-process alarm receiver, no
             service start, no notification. Armed from TerminalService. -->
        <receiver
            android:name=".agent.BotWatchdog"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
